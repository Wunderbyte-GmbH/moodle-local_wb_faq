{{!
    @template local_wb_faq/pagination

    Links to the pages of a list.

    Example context (json):
    {"haspages": true, "hasprevious": false, "hasnext": true, "nextpage": 1, "nexturl": "#", "pages": [{"page": 0, "label": 1, "url": "#", "active": true}, {"page": 1, "label": 2, "url": "#"}]}
}}
{{#haspages}}
<nav aria-label="{{#str}} pagination, local_wb_faq {{/str}}" class="wb-faq-pagination mt-3">
    <ul class="pagination mb-0">
        {{#hasprevious}}
        <li class="page-item">
            <a class="page-link" href="{{{previousurl}}}" data-action="page" data-page="{{previouspage}}">{{#str}} previous {{/str}}</a>
        </li>
        {{/hasprevious}}
        {{#pages}}
        {{#ellipsis}}
        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
        {{/ellipsis}}
        {{^ellipsis}}
        <li class="page-item{{#active}} active{{/active}}">
            <a class="page-link" href="{{{url}}}" data-action="page" data-page="{{page}}"{{#active}} aria-current="page"{{/active}}>{{label}}</a>
        </li>
        {{/ellipsis}}
        {{/pages}}
        {{#hasnext}}
        <li class="page-item">
            <a class="page-link" href="{{{nexturl}}}" data-action="page" data-page="{{nextpage}}">{{#str}} next {{/str}}</a>
        </li>
        {{/hasnext}}
    </ul>
</nav>
{{/haspages}}
