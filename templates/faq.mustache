{{!
    @template local_wb_faq/faq

    The fragment of a category: breadcrumbs, subcategories and a page of questions.

    Example context (json):
    {"uid": "abc", "categoryid": 0, "isempty": true, "canedit": true, "breadcrumbs": [{"id": 0, "name": "FAQ", "url": "#", "active": true}], "categories": [], "entries": [], "pagination": {"haspages": false} }
}}
<div data-region="faq-current" data-categoryid="{{categoryid}}">
    {{#canedit}}
    <div class="wb-faq-addbuttons mb-3">
        <a href="#" class="btn btn-secondary" data-edit-action="form" data-type="category">{{#pix}} t/add, core {{/pix}}{{#str}} addcategory, local_wb_faq {{/str}}</a>
        <a href="#" class="btn btn-secondary" data-edit-action="form" data-type="question">{{#pix}} t/add, core {{/pix}}{{#str}} addquestion, local_wb_faq {{/str}}</a>
    </div>
    {{/canedit}}
    <nav aria-label="{{#str}} breadcrumbs, local_wb_faq {{/str}}">
        <ol class="breadcrumb wb-faq-breadcrumb mb-3">
            {{#breadcrumbs}}
            <li class="breadcrumb-item{{#active}} active{{/active}}"{{#active}} aria-current="page"{{/active}}>
                {{#active}}{{{name}}}{{/active}}
                {{^active}}<a href="{{{url}}}" data-action="goto" data-categoryid="{{id}}">{{{name}}}</a>{{/active}}
            </li>
            {{/breadcrumbs}}
        </ol>
    </nav>
    {{#isempty}}<p class="wb-faq-empty">{{#str}} noentries, local_wb_faq {{/str}}</p>{{/isempty}}
    <ul class="list-unstyled wb-faq-categories" data-region="faq-sortable">
        {{#categories}}
        {{> local_wb_faq/category }}
        {{/categories}}
    </ul>
    <ul class="list-unstyled wb-faq-entries" data-region="faq-sortable">
        {{#entries}}
        {{> local_wb_faq/entry }}
        {{/entries}}
    </ul>
    {{#pagination}}
    {{> local_wb_faq/pagination }}
    {{/pagination}}
</div>
{{#canedit}}
{{#js}}
require(['local_wb_faq/reordering'], function(reordering) {
    reordering.init('{{uid}}');
});
{{/js}}
{{/canedit}}
