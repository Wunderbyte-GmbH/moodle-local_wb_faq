{{!
    @template local_wb_faq/search_results

    The fragment of a search.

    Example context (json):
    {"uid": "abc", "query": "login", "tooshort": false, "hasresults": false, "minlength": 3, "total": 0, "results": [], "pagination": {"haspages": false} }
}}
<div class="wb-faq-search-results">
    <h2 class="h4">{{#str}} searchresults, local_wb_faq, {{total}} {{/str}}</h2>
    {{#tooshort}}<p>{{#str}} stringtooshort, local_wb_faq, {{minlength}} {{/str}}</p>{{/tooshort}}
    {{^tooshort}}{{^hasresults}}<p>{{#str}} noresult, local_wb_faq {{/str}}</p>{{/hasresults}}{{/tooshort}}
    <ul class="list-unstyled">
        {{#results}}
        {{#iscategory}}{{> local_wb_faq/category }}{{/iscategory}}
        {{^iscategory}}{{> local_wb_faq/entry }}{{/iscategory}}
        {{/results}}
    </ul>
    {{#pagination}}
    {{> local_wb_faq/pagination }}
    {{/pagination}}
</div>
