{{!
    @template local_wb_faq/display_search

    The search form. It also works as a plain form if JavaScript is not available.

    Example context (json):
    {"uid": "abc", "query": "", "formaction": "#", "hiddenparams": [], "minlength": 3}
}}
<form class="wb-faq-search mb-3" method="get" action="{{{formaction}}}" role="search" data-region="faq-search-form">
    {{#hiddenparams}}<input type="hidden" name="{{name}}" value="{{value}}">{{/hiddenparams}}
    <label for="wb-faq-search-{{uid}}" class="sr-only visually-hidden">{{#str}} searchfaq, local_wb_faq {{/str}}</label>
    <input id="wb-faq-search-{{uid}}" class="form-control wb-faq-search-input" type="search" name="faqq" value="{{query}}" placeholder="{{#str}} searchfaq, local_wb_faq {{/str}}" autocomplete="off" data-region="faq-search-input">
    <small class="d-none form-text" data-region="faq-search-hint">{{#str}} stringtooshort, local_wb_faq, {{minlength}} {{/str}}</small>
</form>
